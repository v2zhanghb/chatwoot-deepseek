# ============ 运行模式 ============
# mock：不连真实微信，出微信的消息写入本地 outbox（先跑通闭环用这个）
# real：走 qyapi.weixin.qq.com 真实收发
WECHAT_MODE=mock
PORT=8789
LOG_LEVEL=info
DATA_DIR=data

# ============ Chatwoot ============
# 容器内互访用 http://chatwoot:3000；本机跑用 http://localhost:3000
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
# 由 npm run setup 创建 API 渠道后回填
CHATWOOT_INBOX_ID=
# API 渠道的 secret（校验 Chatwoot → 桥接 的签名）；留空则跳过校验
CHATWOOT_CHANNEL_SECRET=

# ============ 微信客服（真实模式才需要）============
# 企业微信后台 → 微信客服 → API：获取 企业ID / Secret / Token / EncodingAESKey
WECHAT_CORP_ID=
WECHAT_KF_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
