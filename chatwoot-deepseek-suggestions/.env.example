# ===== DeepSeek =====
# 必填：你的 DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
# 可选：模型名，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# 可选：API 地址，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：上游请求超时（毫秒）
DEEPSEEK_TIMEOUT_MS=30000

# ===== 本服务 =====
PORT=8787
# 本服务对外地址（Dashboard App 里填的也是它）
APP_ORIGIN=http://localhost:8787
# 允许嵌入/调用本服务的 Chatwoot 来源，多个用英文逗号分隔。
# 只填 Chatwoot 根域名，例如 https://app.chatwoot.com 或 http://localhost:3000，不要带 /app 路径
CHATWOOT_ORIGINS=http://localhost:3000

# ===== 隐私与上下文 =====
# 只取最近 N 条公开文本消息送给 DeepSeek
MAX_CONTEXT_MESSAGES=24
