# Nginx 模板：官方镜像启动时自动 envsubst 渲染（只替换 .env 注入的变量，$host 等 nginx 变量保留）
# 证书放 ./certs/fullchain.pem 与 ./certs/privkey.pem（阿里云免费证书下载 Nginx 格式）

# ---------- 80 -> 443 ----------
server {
    listen 80;
    server_name ${CHATWOOT_DOMAIN} ${SUGGESTIONS_DOMAIN};
    return 301 https://$host$request_uri;
}

# ---------- Chatwoot 主站（含 Widget / API / WebSocket）----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${CHATWOOT_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 50m;

    location / {
        proxy_pass http://chatwoot:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # ActionCable WebSocket（wss）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

# ---------- 话术助手（Chatwoot Dashboard App 的 iframe 源）----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${SUGGESTIONS_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://chatwoot-deepseek-suggestions:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
