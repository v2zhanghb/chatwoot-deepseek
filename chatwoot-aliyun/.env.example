# ============ 复制为 .env 后逐项确认；标【必改】的项上线前必须替换 ============

# ---- 域名（必改）----
CHATWOOT_DOMAIN=chat.example.com
SUGGESTIONS_DOMAIN=huashu.example.com

# Chatwoot 镜像：本机构建后 docker save 传 ECS 用默认值即可；
# 推了 ACR 就改成 registry.cn-beijing.aliyuncs.com/<命名空间>/chatwoot:4.17.1
CHATWOOT_IMAGE=chatwoot-local:4.17.1

# ---- Chatwoot 核心密钥 ----
# 全新部署：用下方命令重新生成，不要复用本地联调值
#   openssl rand -hex 64  -> SECRET_KEY_BASE
#   openssl rand -hex 32  -> LOCKBOX_MASTER_KEY
# 迁移本地旧数据：这两个值必须与本地 chatwoot-local/.env 完全一致，否则历史加密数据解不开
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=__请重新生成强密码__
POSTGRES_DATABASE=chatwoot_production
REDIS_URL=redis://redis:6379
SECRET_KEY_BASE=__请重新生成__
LOCKBOX_MASTER_KEY=__请重新生成__

# ---- 站点 ----
FRONTEND_URL=https://chat.example.com
DEFAULT_LOCALE=zh_CN
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ENABLE_ACCOUNT_SIGNUP=false
SIDEKIQ_CONCURRENCY=5

# ---- 附件存储：阿里云 OSS（S3 兼容）----
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_ACCESS_KEY_ID=__OSS_AccessKey_ID__
STORAGE_SECRET_ACCESS_KEY=__OSS_AccessKey_Secret__
STORAGE_REGION=oss-cn-beijing
STORAGE_BUCKET_NAME=__OSS_Bucket名__
STORAGE_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_FORCE_PATH_STYLE=true

# ---- 网络策略 ----
# 机器人与 chatwoot 同 compose 内网，outgoing_url 走内网地址，保留此开关
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
# 嵌入 widget 的官网本来就是跨域场景，保留
ENABLE_API_CORS=true

# ---- 邮件（多人协作需要；单人可先不配）----
# MAILER_SENDER_EMAIL=chatwoot@example.com
# SMTP_ADDRESS=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_USERNAME=__发信地址__
# SMTP_PASSWORD=__SMTP密码__
# SMTP_DOMAIN=example.com
# SMTP_ENABLE_STARTTLS_AUTO=true

# ---- 可选：ECS 走内网 OSS endpoint 免流量费 ----
# STORAGE_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
